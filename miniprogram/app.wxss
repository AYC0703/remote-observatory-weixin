/* ==================== 主题与全局样式 ==================== */
page {
  background: #0a1426;
  color: #e8eefc;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button, picker {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.muted { color: #93a6c8; }
.small { font-size: 24rpx; }
.strong { font-weight: 600; }
.center { text-align: center; }
.mt { margin-top: 20rpx; }
.mb { margin-bottom: 20rpx; }

.row { display: flex; align-items: center; gap: 16rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* ==================== 卡片 ==================== */
.card {
  background: #12203a;
  border: 1rpx solid #1e3357;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e8eefc;
  margin-bottom: 16rpx;
}
.card-sub {
  font-size: 24rpx;
  color: #93a6c8;
}
.divider { height: 1rpx; background: #1e3357; margin: 20rpx 0; }

/* ==================== 顶部横幅 ==================== */
.hero {
  background: linear-gradient(135deg, #16305c 0%, #0d1b33 100%);
  border: 1rpx solid #24406e;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; color: #a9c0e6; margin-top: 8rpx; }

/* ==================== 按钮 ==================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  background: #1b3660;
  color: #dbe8ff;
  border: 1rpx solid #2a4a7d;
  padding: 0 28rpx;
}
.btn::after { border: none; }
.btn-primary { background: #2f7fe0; border-color: #2f7fe0; color: #ffffff; }
.btn-danger { background: #7a2b34; border-color: #a03a46; color: #ffdfe2; }
.btn-ghost { background: transparent; border-color: #2a4a7d; color: #9fc0ee; }
.btn-block { width: 100%; }
.btn[disabled], .btn.disabled { opacity: 0.5; }
.btn-sm {
  height: 60rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 0 22rpx;
}
.btn-row { display: flex; gap: 16rpx; margin-top: 20rpx; }

/* ==================== 表单 ==================== */
.form-item { margin-bottom: 26rpx; }
.form-label {
  display: block;
  font-size: 26rpx;
  color: #a9c0e6;
  margin-bottom: 12rpx;
}
.form-label .req { color: #ff6b6b; margin-left: 6rpx; }
.input, .textarea, .picker-box {
  width: 100%;
  background: #0e1b34;
  border: 1rpx solid #24406e;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  color: #e8eefc;
  font-size: 28rpx;
  min-height: 84rpx;
}
.textarea { min-height: 180rpx; }
.picker-box { display: flex; align-items: center; justify-content: space-between; }
.picker-box .placeholder { color: #64789e; }
.input-placeholder { color: #64789e; }
.field-error { color: #ff8080; font-size: 24rpx; margin-top: 10rpx; }

/* ==================== 标签 ==================== */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  border: 1rpx solid transparent;
}
.tag-pending { color: #ffcf70; background: rgba(245, 166, 35, 0.14); border-color: rgba(245, 166, 35, 0.5); }
.tag-approved { color: #7bf0ac; background: rgba(46, 204, 113, 0.14); border-color: rgba(46, 204, 113, 0.5); }
.tag-rejected { color: #ff9a9a; background: rgba(255, 92, 92, 0.14); border-color: rgba(255, 92, 92, 0.5); }
.tag-withdrawn { color: #b6c2d6; background: rgba(138, 148, 166, 0.16); border-color: rgba(138, 148, 166, 0.5); }
.tag-default { color: #9fc0ee; background: rgba(77, 163, 255, 0.14); border-color: rgba(77, 163, 255, 0.5); }

/* ==================== 列表项 ==================== */
.list-item {
  background: #12203a;
  border: 1rpx solid #1e3357;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
}
.list-item:active { background: #16273f; }
.item-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.item-no { font-size: 28rpx; font-weight: 600; color: #cfe0ff; }
.item-line { font-size: 26rpx; color: #b7c8e6; margin-top: 6rpx; }
.item-line .k { color: #8199c0; }

/* ==================== 空状态与加载 ==================== */
.empty { padding: 100rpx 40rpx; text-align: center; color: #6d82a8; }
.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.loading { padding: 60rpx; text-align: center; color: #6d82a8; }

/* ==================== 指标卡 ==================== */
.metric-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.metric {
  flex: 1 1 44%;
  background: #12203a;
  border: 1rpx solid #1e3357;
  border-radius: 18rpx;
  padding: 24rpx;
}
.metric-value { font-size: 44rpx; font-weight: 700; }
.metric-label { font-size: 24rpx; color: #93a6c8; margin-top: 6rpx; }

/* ==================== 功能入口 ==================== */
.menu-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.menu-item {
  flex: 1 1 46%;
  background: #12203a;
  border: 1rpx solid #1e3357;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
}
.menu-item:active { background: #172944; }
.menu-icon { font-size: 44rpx; }
.menu-name { font-size: 28rpx; font-weight: 600; margin-top: 12rpx; }
.menu-desc { font-size: 22rpx; color: #8199c0; margin-top: 6rpx; }

/* ==================== 时间线 ==================== */
.timeline { padding-left: 8rpx; }
.timeline-item { position: relative; padding: 0 0 28rpx 34rpx; border-left: 2rpx solid #24406e; }
.timeline-item:last-child { border-left-color: transparent; padding-bottom: 0; }
.timeline-dot {
  position: absolute;
  left: -13rpx;
  top: 4rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #4da3ff;
  border: 4rpx solid #0a1426;
}
.timeline-title { font-size: 27rpx; font-weight: 600; }
.timeline-meta { font-size: 23rpx; color: #8199c0; margin-top: 6rpx; }
.timeline-comment {
  font-size: 25rpx;
  color: #c7d5ee;
  margin-top: 10rpx;
  background: #0e1b34;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

/* ==================== 筛选栏 ==================== */
.filter-bar { display: flex; gap: 14rpx; margin-bottom: 22rpx; overflow-x: auto; white-space: nowrap; }
.chip {
  flex: 0 0 auto;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #12203a;
  border: 1rpx solid #1e3357;
  color: #93a6c8;
  font-size: 25rpx;
}
.chip.active { background: #2f7fe0; border-color: #2f7fe0; color: #ffffff; }

/* ==================== 日历 ==================== */
.cal-slot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #0e1b34;
  margin-bottom: 12rpx;
  border-left: 8rpx solid #4da3ff;
}
.cal-slot.pending { border-left-color: #f5a623; }
.cal-slot.approved { border-left-color: #2ecc71; }
.cal-time { font-size: 25rpx; color: #c7d5ee; }

/* ==================== 分页 ==================== */
.pager { display: flex; align-items: center; justify-content: center; gap: 24rpx; padding: 20rpx 0 40rpx; }
.pager-text { font-size: 26rpx; color: #93a6c8; }

/* ==================== 弹窗 ==================== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(4, 9, 18, 0.72);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.modal-box {
  width: 100%;
  max-width: 660rpx;
  background: #12203a;
  border: 1rpx solid #24406e;
  border-radius: 24rpx;
  padding: 34rpx;
  max-height: 84vh;
  overflow-y: auto;
}

/* ==================== 登录 / 注册 ==================== */
.auth-page { min-height: 100vh; padding: 80rpx 40rpx 40rpx; }
.auth-brand { text-align: center; margin-bottom: 56rpx; }
.auth-logo { font-size: 96rpx; line-height: 1; }
.auth-title { font-size: 44rpx; font-weight: 700; margin-top: 20rpx; letter-spacing: 2rpx; }
.auth-sub { font-size: 25rpx; color: #8199c0; margin-top: 12rpx; }
.auth-switch { text-align: center; font-size: 25rpx; color: #93a6c8; margin-top: 28rpx; }
.link { color: #4da3ff; margin-left: 6rpx; }
