.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2f7fe0;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.arrow { font-size: 44rpx; color: #5f7aa6; }
.info-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #1e3357;
  font-size: 27rpx;
}
.info-line:last-child { border-bottom: none; }
.info-line .k { color: #8199c0; }
