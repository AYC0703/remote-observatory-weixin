<view class="auth-page">
  <view class="auth-brand">
    <view class="auth-logo">🔭</view>
    <view class="auth-title">注册账号</view>
    <view class="auth-sub">注册成功后将自动登录</view>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="form-label">用户名<text class="req">*</text></text>
      <input class="input" placeholder="3-20 位字母、数字或下划线" placeholder-class="input-placeholder"
        value="{{username}}" data-field="username" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">显示名称</text>
      <input class="input" placeholder="选填，默认与用户名相同" placeholder-class="input-placeholder"
        value="{{name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">密码<text class="req">*</text></text>
      <input class="input" password placeholder="至少 6 位" placeholder-class="input-placeholder"
        value="{{password}}" data-field="password" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">确认密码<text class="req">*</text></text>
      <input class="input" password placeholder="请再次输入密码" placeholder-class="input-placeholder"
        value="{{confirm}}" data-field="confirm" bindinput="onInput" />
    </view>
    <view wx:if="{{error}}" class="field-error">{{error}}</view>
    <button class="btn btn-primary btn-block" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">注 册</button>
    <view class="auth-switch">已有账号？<text class="link" bindtap="goBack">返回登录</text></view>
  </view>
</view>
